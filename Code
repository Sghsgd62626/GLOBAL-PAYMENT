<footer><span>© 2026 ARES GLOBAL PAYMENTS</span><span>Демо-интерфейс · Реальная оплата не подключена</span></footer></main>
<script>
const packs=[{g:500,p:100,tag:'СТАРТ',note:'Небольшой запас для первых покупок',color:'#67d8ff',dark:'#3ba8e0',bg:'linear-gradient(135deg,#163b67,#276e9e)'},{g:1500,p:250,tag:'ПОПУЛЯРНЫЙ',note:'Для новых образов и эмоций',color:'#8ce58d',dark:'#4cbd71',bg:'linear-gradient(135deg,#1c573f,#348b60)'},{g:3500,p:500,tag:'ВЫГОДНО',note:'Больше Gems — больше возможностей',color:'#ffc85b',dark:'#e99b31',bg:'linear-gradient(135deg,#65401c,#b8792a)'},{g:7500,p:1000,tag:'МАКСИМУМ',note:'Самый большой набор Gems',color:'#c5a0ff',dark:'#8b5cf6',bg:'linear-gradient(135deg,#3c286f,#7652b9)',best:true}];let chosen=null;const fmt=n=>new Intl.NumberFormat('ru-RU').format(n)+' ₽';
const grid=document.getElementById('products');packs.forEach(x=>{let c=document.createElement('article');c.className='card'+(x.best?' best':'');c.style.setProperty('--pack',x.color);c.style.setProperty('--pack-dark',x.dark);c.style.setProperty('--pack-bg',x.bg);c.innerHTML=(x.tag?'<span class="tag">'+x.tag+'</span>':'')+'<div class="gem"><span>💎</span><span>💎</span><span>💎</span></div><div class="amount">'+x.g.toLocaleString('ru-RU')+'</div><div class="muted">GEMS</div><div class="pack-note">'+x.note+'</div><div class="price">'+fmt(x.p)+'</div><button>Выбрать набор</button>';c.querySelector('button').onclick=()=>{chosen=x;render()};grid.append(c)});
function render(){document.getElementById('cart').textContent=chosen?chosen.g.toLocaleString('ru-RU')+' Gems':'Пока ничего не выбрано.';document.getElementById('total').textContent=chosen?fmt(chosen.p):'0 ₽';}
document.getElementById('clear').onclick=()=>{chosen=null;render();document.getElementById('status').textContent='Корзина очищена.'};
document.getElementById('checkout').onclick=()=>{let s=document.getElementById('status');if(!chosen){s.textContent='Сначала выбери набор Gems.';return}let id='ARES-DEMO-'+Date.now().toString().slice(-7);s.textContent='Тестовый заказ '+id+': '+chosen.g+' Gems за '+fmt(chosen.p)+'. Деньги не списывались, Gems не начислялись.'};
</script></body></html>
